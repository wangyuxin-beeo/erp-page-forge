{
  "specVersion": "1.0",
  "title": "components",
  "meta": {
    "purpose": "组件契约层 —— PageSpec 只声明「语义组件 + 能力」，渲染层按 render_mode 把它映射成具体实现。",
    "layer": "第 ② 层。与具体组件库无关：换库只改本文件 targets 与第 ③ 层实现，PageSpec、四类断言、验收报告全不动。",
    "status": "Only self rendering is implemented; public library mappings are design references.",
    "consumers": [
      "人读 / 模型读：写 PageSpec 时从 components 里取 component id 与 capabilities",
      "build/forge.py：暂未消费（render_mode 分派未实现，见 docs/component-library-strategy.md）",
      "未来渲染适配层：按 targets 派发到各库"
    ],
    "naming": "id 为 kebab-case 英文语义名；zh 与 spec/archetypes.json 的 regions 中文写法对齐差异一律记入 aliases，避免同一块区域出现两个名字。",
    "aliases_rule": "aliases 必须收录 spec/archetypes.json 里 region 的全部写法（含括号后缀变体），以便从原型区域名反查组件 id。"
  },
  "renderModes": {
    "self": {
      "label": "自绘 HTML",
      "kind": "native",
      "ecosystem": "—",
      "status": "active",
      "note": "唯一实现。产物为单文件 HTML，零依赖，可像素比对。"
    },
    "antd": {
      "label": "Ant Design",
      "kind": "web",
      "ecosystem": "React",
      "status": "planned",
      "note": "已登记组件名，未接入。仅作术语与分类的交叉核对基准。"
    },
    "arco": {
      "label": "Arco Design",
      "kind": "web",
      "ecosystem": "React / Vue",
      "status": "planned",
      "note": "与 antd 分类高度一致，作为交叉核对参考。"
    },
    "element": {
      "label": "Element Plus",
      "kind": "web",
      "ecosystem": "Vue 3",
      "status": "planned",
      "note": "Vue 生态对照。"
    }
  },
  "slots": {
    "note": "组件在页面框架中的位置。用于判断吸附、联动这类依赖位置的能力是否成立。",
    "sidebar": "左侧贯通区",
    "topbar": "内容区顶部通栏",
    "header": "内容区起始的标题与操作区",
    "body": "内容区主体",
    "aside": "内容区右侧栏（抽屉 / 辅助面板）",
    "footer": "容器底部吸附区",
    "overlay": "浮层（不占文档流）",
    "none": "不落页面框架（如空状态、骨架屏这类状态型组件）"
  },
  "capabilities": {
    "note": "能力项是「同一组件的不同形态」的表达方式 —— 例如 A1 的「页面头」、A4 的「页面头（含时间范围）」、A6 的「页面头（切换/导出/打印）」是同一个组件开不同能力。",
    "sticky": "吸顶 / 黏附：滚动时固定在视口边缘",
    "float": "悬浮：脱离文档流并带投影",
    "collapsible": "可折叠：可收起为图标模式",
    "scroll-spy": "联动：高亮随内容滚动自动切换（单张截图不可判定）",
    "group": "分组：含分组标题与分组内项",
    "sub-menu": "多级：支持二级及以上展开",
    "select": "单选",
    "multi-select": "多选",
    "checkable": "行可勾选",
    "sortable": "列可排序",
    "resizable": "列宽可拖拽",
    "fixed-column": "列固定（左右冻结）",
    "virtual-scroll": "虚拟滚动",
    "inline-edit": "单元格行内编辑",
    "tree-data": "树形数据",
    "pagination": "分页",
    "page-size": "每页条数可切换",
    "summary-row": "底部汇总行",
    "bulk-actions": "批量操作（依赖 checkable）",
    "row-actions": "行内操作",
    "header-actions": "页面级操作",
    "export": "导出",
    "print": "打印",
    "time-range": "时间范围切换",
    "switch-view": "视图切换（如列表 / 卡片）",
    "attachment": "附件上传与列表",
    "version-history": "版本历史"
