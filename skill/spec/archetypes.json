{
  "specVersion": "1.0",
  "title": "archetypes",
  "meta": {
    "purpose": "A1–A6 的必需元素与交互断言清单（references/page-archetypes.md 的可执行化版本）。",
    "consumers": [
      "build/verify_contract.py —— 消费 static 段，做产物静态文本断言",
      "build/verify_acceptance.py —— 消费 static/render/interaction/data 四段，出验收报告",
      "SKILL.md 工作流 —— 生成前用 --plan 模式把本次验收项列给用户看（验收清单前置）"
    ],
    "kinds": {
      "text": "产物文本需包含该子串",
      "text_all": "需包含全部子串",
      "text_any": "至少包含其一",
      "regex": "需匹配该正则",
      "regex_count": "正则命中次数需 >= min",
      "absent": "不得出现该子串（反例防线）",
      "dom": "渲染后 DOM 断言，参数见 domSpec",
      "interaction": "交互断言，交给 driver 执行",
      "data": "数据自洽断言，交给 driver 执行"
    },
    "severity": {
      "hard": "硬性，不过即不合格（契约/渲染/数据）",
      "soft": "建议项，不过仅提示（视觉类）"
    },
    "executionOrder": {
      "note": "★ 断言执行顺序有语义：只读断言必须排在改状态的断言之前，否则前一步的点击会污染后一步的观察。",
      "order": [
        "contract",
        "render",
        "data",
        "interaction"
      ],
      "evidence": "实测踩到过：data 断言原先排在 interaction 之后，前序的「同意/驳回」把页面状态改乱，导致时间线与枚举断言看到的是被操作过的页面，产生假失败。同一数组内部的 interaction 也要按「只读 → 改状态」排，破坏性动作放最后。"
    },
    "hints": {
      "purpose": "通用 driver 靠文本与语义启发式驱动页面；产物类名千差万别时，允许在 PageSpec.interactionHints 里声明锚点选择器，driver 优先使用。",
      "keys": {
        "taskCard": "列表/任务卡片元素选择器",
        "detailAnchor": "详情区标题元素选择器（用于判断切换是否生效）",
        "todoBadge": "待办计数所在元素选择器",
        "dialog": "弹窗容器选择器",
        "dialogInput": "弹窗内输入控件选择器",
        "table": "数据表格选择器",
        "summaryRow": "汇总行选择器"
      }
    }
  },
  "archetypes": {
    "A1": {
      "name": "管理列表页",
      "aliases": [
        "列表",
        "管理",
        "档案",
        "台账列表"
      ],
      "regions": [
        "页面头",
        "查询区",
        "工具条",
        "数据表格",
        "分页器"
      ],
      "regionOrderFixed": true,
      "static": [
        {
          "id": "A1.query-actions",
          "kind": "text_all",
          "values": [
            "查询",
            "重置"
          ],
          "severity": "hard",
          "desc": "查询区有查询与重置两个动作"
        },
        {
          "id": "A1.empty-state",
          "kind": "text",
          "value": "没有符合条件的数据",
          "severity": "hard",
          "desc": "空状态有兜底文案，不是白表格"
        },
        {
          "id": "A1.bulk-hint",
          "kind": "text",
          "value": "已选",
          "severity": "hard",
          "desc": "工具条显示已选数量"
        },
        {
          "id": "A1.nowrap-rule",
          "kind": "regex",
          "pattern": "white-space\\s*:\\s*nowrap",
          "severity": "hard",
          "desc": "数字/时间列有 nowrap（防折行，是规范铁律）"
        },
        {
          "id": "A1.minmax-rule",
          "kind": "regex",
          "pattern": "minmax\\(0\\s*,\\s*1fr\\)",
          "severity": "soft",
          "desc": "弹性列建议用 minmax(0,1fr) 而非裸 1fr（写法自由，真保障由渲染断言提供）"
        },
        {
          "id": "A1.anti-raw-color",
          "kind": "absent",
          "value": "#409EFF",
          "severity": "soft",
          "desc": "不得出现随手色值"
        }
      ],
      "render": [
        {
          "id": "A1.no-script-error",
          "kind": "dom",
          "domSpec": {
            "forbidScriptErrors": true
          },
          "severity": "hard",
          "desc": "页面脚本零运行错误（白屏/空表格的根因通常在这里）"
        },
        {
          "id": "A1.no-empty-column",
          "kind": "dom",
          "domSpec": {
            "noAllEmptyColumns": true
          },
          "severity": "hard",
          "desc": "表格没有「整列全空」的列（值没接上数据的典型症状）"
        },
        {
          "id": "A1.no-overflow-1280",
          "kind": "dom",
          "domSpec": {
            "maxOverflowPx": 2
          },
          "severity": "hard",
          "desc": "1280px 视口无横向溢出"
        },
        {
          "id": "A1.no-dirty",
          "kind": "dom",
          "domSpec": {
            "forbidDirty": true
          },
          "severity": "hard",
          "desc": "渲染后无 undefined / NaN / [object Object]"
        },
        {
          "id": "A1.not-blank",
          "kind": "dom",
          "domSpec": {
            "minTextLen": 600
          },
          "severity": "hard",
          "desc": "正文非空（下限 600 字，按原型内容量定）"
        },
        {
          "id": "A1.pager-total",
          "kind": "dom",
          "domSpec": {
            "textMatch": "共[^条]{0,40}[\\d,]+[^条]{0,20}条"
          },
          "severity": "hard",
          "desc": "分页器渲染后显示总条数（运行时渲染，故按渲染文本判定）"
        }
      ],
      "interaction": [
        {
          "id": "A1.filter",
          "driver": "filter_changes_rows",
          "severity": "hard",
          "desc": "输入条件点查询 → 表格行数变化"
        },
        {
          "id": "A1.reset",
          "driver": "reset_restores_rows",
          "severity": "hard",
          "desc": "点重置 → 条件清空且恢复全量"
        },
        {
          "id": "A1.sort",
          "driver": "sort_reorders",
          "severity": "hard",
          "desc": "点表头 → 数据重排且有升降序指示"
        },
        {
          "id": "A1.paginate",
          "driver": "pagination_changes_rows",
          "severity": "hard",
          "desc": "翻页 → 内容变化且显示第 X-Y 条"
        },
        {
          "id": "A1.bulk",
          "driver": "bulk_enables_on_select",
          "severity": "hard",
          "desc": "勾选后批量按钮由禁用变可用"
        },
        {
          "id": "A1.empty",
          "driver": "empty_state_on_no_match",
          "severity": "hard",
          "desc": "筛选不到 → 显示空状态而非空白"
        }
