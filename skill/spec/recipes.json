      "listColumns": ["客户编码", "客户名称", "客户类型", "信用额度", "可用额度", "信用状态", "销售负责人", "最近成交时间", "状态"],
      "statusMachine": {
        "states": [
          { "name": "潜在", "tone": "neutral" },
          { "name": "合作中", "tone": "ok" },
          { "name": "暂停合作", "tone": "warn" },
          { "name": "已终止", "tone": "danger", "terminal": true }
