        { "name": "已用额度", "key": "creditUsed", "type": "money", "align": "right", "precision": 2 },
        { "name": "可用额度", "key": "creditAvailable", "type": "money", "align": "right", "precision": 2 },
        { "name": "信用状态", "key": "creditStatus", "type": "enum", "options": ["正常", "预警", "冻结"] },
        { "name": "信用账期", "key": "creditDays", "type": "number", "unit": "天" },
        { "name": "销售负责人", "key": "owner", "type": "person" },
