{
  "specVersion": "1.0",
  "title": "recipes",
  "meta": {
    "purpose": "14 类 ERP 实体的结构化字段配方 —— 生成层据此把「实体名」直接展开成可用的字段表、列配置与状态机，不再靠模型凭空想字段。",
    "source": "references/entity-recipes.md 的结构化版本；语义说明仍以该文档为准。",
    "fieldShape": "与 PageSpec.fields 一致：{name, key, type, required, unique, options, control, align, precision, unit}。生成层可直接落入 PageSpec。",
    "usage": [
      "命中实体 → 照抄 fields，再按页面原型挑 listColumns / formGroups / detailTabs",
      "未命中 → 用 general 通用骨架扩展",
      "listColumns 只取 6–10 列：编码 + 名称 + 关键业务字段 2–3 个 + 金额 + 状态 + 时间 + 操作"
    ]
  },

  "general": {
    "name": "通用字段骨架",
    "codeRule": "前缀-年份-序号",
    "codeExample": "SO-20260917-0081",
    "groups": {
      "identity": ["编码", "名称", "类型/分类", "规格型号", "计量单位"],
      "ownership": ["所属组织", "责任部门", "负责人", "关联客户/供应商"],
      "status": ["状态", "是否启用", "生效日期", "失效日期"],
      "audit": ["创建人", "创建时间", "最后修改人", "最后修改时间", "备注"]
    },
    "rules": [
      "编码一律 前缀-年份-序号，严禁 1/2/3 这类无意义主键",
      "展示层用中文业务术语，代码层用驼峰 key",
      "字段顺序：先身份后业务，先编码后名称，先金额后时间",
      "每页至少 1 条预警/异常（超期、超信用、呆滞、驳回），让页面能讲出一个业务问题"
    ]
  },

  "entities": {
